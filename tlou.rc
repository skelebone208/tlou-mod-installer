      VALUE "InternalName", "TLOU Mod Installer"
      VALUE "LegalCopyright", "Copyright (c) 2026 TLOU Mod Installer contributors. MIT License."
      VALUE "OriginalFilename", "TLOU Mod Installer.exe"
      VALUE "ProductName", "TLOU Mod Installer"
      VALUE "ProductVersion", "1.3.1.0"
      VALUE "Comments", "Free, open-source mod installer for The Last of Us Part I and Part II Remastered (PC). Makes no network connections."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
